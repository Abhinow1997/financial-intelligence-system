# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# --- Tooling ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Secrets / env (NEVER commit) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/
# Snowflake connection files hold tokens (PATs)
.snowflake/
connections.toml

# --- Data lake (keep dirs via .gitkeep, ignore contents) ---
data/raw/*
data/processed/*
data/features/*
!data/**/.gitkeep
!data/samples/**
# DuckDB fact store: generated by src/facts/build.py and the loaders; track it with DVC, never Git
data/facts/*.duckdb
data/facts/*.duckdb.wal

# --- Models / vectors / artifacts ---
*.pkl
*.joblib
*.onnx
*.faiss
artifacts/
mlruns/

# --- Airflow (keep dirs via .gitkeep, ignore runtime output) ---
logs/*
!logs/.gitkeep
config/airflow.cfg
plugins/__pycache__/

# --- GitHub Agentic Workflows (Lab 7): local run logs from `gh aw logs` / `gh aw audit` ---
.github/aw/logs/

# --- Notebooks ---
.ipynb_checkpoints/

# --- OS / IDE ---
.DS_Store
Thumbs.db
.idea/
.vscode/
