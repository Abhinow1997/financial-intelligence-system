# Copy to .env for local development:  cp .env.example .env
# .env is gitignored. NEVER put real secrets, API keys, or PII in this file.

ENV=dev
LOG_LEVEL=INFO

# Service URLs (compose overrides these with in-network hostnames)
GATEWAY_URL=http://localhost:8080
BACKEND_URL=http://localhost:8000

# Model provider credentials - leave blank locally, inject from a secret manager in CI/prod.
MODEL_API_KEY=

# --- Airflow (docker-compose-airflow.yaml) ---
# Non-root uid inside the Airflow containers. 50000 is correct on Docker Desktop;
# on native Linux use your own: AIRFLOW_UID=$(id -u)
AIRFLOW_UID=50000

# Encrypts Airflow connections/variables at rest. REQUIRED - the compose file has no
# default for it, and an empty value means every container invents its own key, so the
# scheduler cannot decrypt what the webserver wrote. Generate your own:
#   python -c "import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=

# Signs the internal task-execution API tokens. Any non-empty string works locally.
AIRFLOW__API_AUTH__JWT_SECRET=

# Bootstrap admin for the Airflow UI. Local dev only - never reuse real credentials.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Host port for the Airflow UI. Defaults to 8088 because the `gateway` service and
# most other Airflow installs already claim 8080. Host side only - the container
# still listens on 8080.
AIRFLOW_PORT=8088
