# Root build context (used by services that install from the root pyproject.toml).
# Keep the context small: only pyproject.toml, poetry.lock and the one service
# directory a Dockerfile copies are actually needed.
.git/
.github/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local data lake, notebooks and docs never belong in a runtime image.
data/
notebooks/
docs/
evals/
infra/

# Secrets
.env
.env.*
!.env.example
