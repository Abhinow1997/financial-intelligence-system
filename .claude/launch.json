{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "poetry",
      "runtimeArgs": ["run", "uvicorn", "--app-dir", "services/backend", "app.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "poetry",
      "runtimeArgs": ["run", "streamlit", "run", "services/frontend/app/app.py", "--server.port", "8501", "--server.headless", "true"],
      "port": 8501
    }
  ]
}
